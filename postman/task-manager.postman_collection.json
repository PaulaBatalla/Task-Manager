	"item": [
		{
			"name": "Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Verifica que el login fue exitoso\r",
							"pm.test(\"Login exitoso - código 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Verifica que la respuesta tiene un token\r",
							"pm.test(\"La respuesta contiene un token\", function () {\r",
							"    const data = pm.response.json();\r",
							"    pm.expect(data).to.have.property(\"token\");\r",
							"});\r",
							"\r",
							"// Guarda el token automáticamente en la variable de entorno\r",
							"const data = pm.response.json();\r",
							"if (data.token) {\r",
							"    pm.environment.set(\"token\", data.token);\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"email\": \"miemail@hotmail.com\",\r\n    \"password\": \"abc123\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url}}/api/auth/login",
					"host": [
						"{{url}}"
					],
					"path": [
						"api",
						"auth",
						"login"
					]
				}
			},
			"response": []
		},
