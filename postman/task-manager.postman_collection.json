		{
			"name": "Crear tarea",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Tarea creada exitosamente - código 201\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"pm.test(\"La tarea tiene los campos correctos\", function () {\r",
							"    const data = pm.response.json();\r",
							"    pm.expect(data).to.have.property(\"id\");\r",
							"    pm.expect(data).to.have.property(\"title\");\r",
							"    pm.expect(data.title).to.equal(\"Tarea de prueba\");\r",
							"    pm.expect(data.priority).to.equal(\"HIGH\");\r",
							"    pm.expect(data.status).to.equal(\"PENDING\");\r",
							"});\r",
							"\r",
							"// Guarda el id de la tarea para usarlo en los próximos requests\r",
							"const data = pm.response.json();\r",
							"if (data.id) {\r",
							"    pm.environment.set(\"taskId\", data.id);\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
